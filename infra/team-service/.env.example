# Runtime public configuration only. Never put the Clerk secret key here.
T3_TEAM_CLERK_PUBLISHABLE_KEY=
T3_TEAM_ORIGINS=http://localhost:3910
# Comma-separated Clerk user IDs allowed to create team projects.
T3_TEAM_CREATORS=
# Configure both public OAuth settings to enable native device sign-in.
T3_TEAM_OAUTH_ISSUER=
T3_TEAM_OAUTH_CLIENT_ID=
# Absolute directory containing the mounted Clerk secret file.
T3_TEAM_SECRETS_DIR=/home/notorious/t3-team-service-dev/secrets
# Match the dedicated deployment file owner; both must remain nonzero.
T3_TEAM_UID=1000
T3_TEAM_GID=1000
